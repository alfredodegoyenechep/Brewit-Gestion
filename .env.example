# Preparación local. No contiene credenciales reales.
BREWIT_POSTGRES_PASSWORD=
BREWIT_DATABASE_URL=postgresql://brewit:REEMPLAZAR@127.0.0.1:55433/brewit_operations
# Generar una vez: node -e "process.stdout.write(require('crypto').randomBytes(32).toString('hex'))"
BREWIT_AUTH_KEY=
# Protege también API/archivos históricos; solo Dirección accede a esas rutas
# mientras no incorporen permisos por ubicación.
BREWIT_REQUIRE_AUTH=1
